**

# The Linux quality image receives only maintained build inputs.
!.dockerignore
!Dockerfile.quality
!Cargo.lock
!Cargo.toml
!rust-toolchain.toml
!.worktreeinclude

!.cargo/
!.cargo/**
!.config/
!.config/wt.toml
!crates/
!crates/**
!provenance/
!provenance/**
!scripts/
!scripts/**

# Final denies override broad source-directory exceptions above.
**/.git
**/.git/**
**/target
**/target/**
**/.env
**/.env.*
**/.cargo/credentials
**/.cargo/credentials.toml
**/*.db
**/*.db-*
**/*.key
**/*.log
**/*.p12
**/*.pem
**/*.pfx
**/*.pid
**/*.sock
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/.DS_Store
